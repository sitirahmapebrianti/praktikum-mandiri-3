<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Pemesanan Barang</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f0f0;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 800px;
            background-color: #d1ebd5; /* Warna latar hijau muda sesuai gambar */
            border: 1px solid #ccc;
            padding: 15px;
            box-sizing: border-box;
        }
        /* Navigation Bar */
        .navbar {
            display: flex;
            justify-content: space-around;
            background-color: #fff;
            border: 1px solid #999;
            padding: 8px 0;
            margin-bottom: 20px;
        }
        .navbar a {
            text-decoration: none;
            color: #000;
            font-size: 14px;
            font-weight: bold;
        }
        /* Main Content Grid */
        .content {
            display: flex;
            gap: 20px;
        }
        /* Left Column (Image Upload) */
        .left-col {
            width: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .image-placeholder {
            width: 180px;
            height: 180px;
            border: 1px solid #000;
            background-color: #fff;
            position: relative;
            margin-bottom: 10px;
        }
        /* Membuat tanda silang (X) pada placeholder gambar */
        .image-placeholder::before, .image-placeholder::after {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            width: 1px;
            height: 100%;
            background-color: #999;
        }
        .image-placeholder::before { transform: rotate(45deg); }
        .image-placeholder::after { transform: rotate(-45deg); }
        
        .upload-btn {
            padding: 5px 15px;
            background-color: #fff;
            border: 1px solid #000;
            cursor: pointer;
            font-size: 12px;
        }
        /* Right Column (Form fields) */
        .right-col {
            flex: 1;
        }
        .form-group {
            display: flex;
            margin-bottom: 12px;
            align-items: flex-start;
        }
        .form-group label {
            width: 150px;
            font-size: 13px;
            font-weight: bold;
            padding-top: 3px;
        }
        .form-group input[type="text"], 
        .form-group textarea, 
        .form-group select {
            flex: 1;
            padding: 4px;
            border: 1px solid #000;
            background-color: #fff;
            font-family: inherit;
            font-size: 13px;
        }
        .form-group textarea {
            height: 80px;
            resize: none;
        }
        .form-group select {
            max-width: 150px;
        }
        .info-text {
            font-size: 11px;
            color: #333;
            margin-top: 2px;
            font-style: italic;
        }
        .checkbox-group {
            margin-left: 150px;
            margin-bottom: 5px;
            font-size: 13px;
        }
        .checkbox-group label {
            font-weight: normal;
        }
        /* Submit Button */
        .btn-container {
            margin-left: 150px;
            margin-top: 15px;
        }
        .submit-btn {
            background-color: #008000;
            color: #fff;
            border: 1px solid #000;
            padding: 6px 15px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Navbar atas -->
    <div class="navbar">
        <a href="#">Home</a>
        <a href="#">Generate Link</a>
        <a href="#">Transaction History</a>
        <a href="#">Policy</a>
        <a href="#">Logout</a>
    </div>

    <!-- Konten Utama Form -->
    <div class="content">
        <!-- Sisi Kiri: Upload Gambar -->
        <div class="left-col">
            <div class="image-placeholder"></div>
            <button type="button" class="upload-btn">Upload Picture</button>
        </div>

        <!-- Sisi Kanan: Input Data -->
        <div class="right-col">
            <form action="#" method="POST">
                
                <div class="form-group">
                    <label for="title">Title Here</label>
                    <input type="text" id="title" name="title" value=>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description">&#10; &#10;</textarea>
                </div>

                <div class="form-group">
                    <label for="account-number">Account Number</label>
                    <input type="text" id="account-number" name="account_number" value=>
                </div>

                <div class="form-group">
                    <label for="bank">Bank</label>
                    <select id="bank" name="bank">
                        <option value="HSBC" selected></option>
                        <option value="BCA">BCA</option>
                        <option value="Mandiri">Mandiri</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="account-holder">Account Holder</label>
                    <input type="text" id="account-holder" name="account_holder" value=>
                </div>

                <div class="form-group" style="margin-bottom: 5px;">
                    <label for="transaction">Transaction</label>
                    <div>
                        <select id="transaction" name="transaction">
                            <option value="1" selected></option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                        </select>
                        <div class="info-text">* if the transaction is for 3 person, choose 3 from the drop-down list</div>
                    </div>
                </div>

                <!-- Pilihan Checkbox -->
                <div class="checkbox-group">
                    <input type="checkbox" id="send-mobile-check" name="send_mobile_check" checked>
                    <label for="send-mobile-check">Send to Mobile Phone</label>
                </div>
                <div class="checkbox-group" style="margin-bottom: 12px;">
                    <input type="checkbox" id="send-email-check" name="send_email_check" checked>
                    <label for="send-email-check">Send to Email</label>
                </div>

                <div class="form-group">
                    <label for="mobile-phone">Send to Mobile Phone</label>
                    <input type="text" id="mobile-phone" name="mobile_phone" value=>
                </div>

                <div class="form-group">
                    <label for="email">Send to Email</label>
                    <input type="text" id="email" name="email" value=>
                </div>

                <!-- Tombol Submit -->
                <div class="btn-container">
                    <button type="submit" class="submit-btn">Generate Link</button>
                </div>

            </form>
        </div>
    </div>
</div>

</body>
</html>